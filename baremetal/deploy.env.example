# Settings for baremetal/install.sh. Copy, edit, then:  sudo ./install.sh --config site.env
# Anything unset takes the default shown.

PROJECT=mysite                 # name used for the service, config and log files (a-z 0-9 -)
ODOO_VERSION=19                # 16 .. 20
ODOO_EDITION=community         # community | enterprise
#ENTERPRISE_SRC=/opt/odoo19/enterprise   # required for enterprise: a checkout of the enterprise addons
#CUSTOM_ADDONS=/opt/odoo19/custom,/opt/odoo19/third-party   # comma-separated extra addons directories
ODOO_SRC=/opt/odoo19/odoo      # community source; cloned (depth 1, branch ${ODOO_VERSION}.0) if missing
VENV=/opt/odoo19/venv          # Python virtualenv for Odoo's requirements
DATA_DIR=/var/lib/odoo         # filestore and sessions (put it on your fastest/largest volume)
LOG_DIR=/var/log/odoo
BACKUP_DIR=/var/backups/odoo
BACKUP_KEEP_DAYS=14
DB_NAME=mysite
PG_VERSION=18
#PYTHON_BIN=python3            # interpreter for the venv; Odoo 17+ needs 3.10+, 19/20 prefer 3.12.
                               # On Ubuntu with an older system Python, install.sh adds the deadsnakes PPA
                               # and uses python3.12 unless PYTHON_FROM_PPA=false
#PG_DATA_DIR=                  # custom cluster location, e.g. /data/postgresql (default: distro default)
HTTP_PORT=8069
GEVENT_PORT=8072
USE_NGINX=true                 # nginx in front on NGINX_PORT, Odoo bound to 127.0.0.1
NGINX_PORT=80
#DOMAIN=odoo.example.com       # with USE_NGINX: https via Let's Encrypt (DNS must point here, port 80 reachable)
#ADMIN_PASSWD=                 # master password; empty = random, written to the config file
TIMEZONE=UTC
HUGEPAGES=auto                 # auto (on when RAM >= 8 GB) | on | off
INIT_DB=true                   # initialise DB_NAME with base,web (no demo data) if it is empty
