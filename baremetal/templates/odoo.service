# /etc/systemd/system/${SERVICE}.service - generated by baremetal/install.sh
[Unit]
Description=Odoo ${ODOO_VERSION} ${ODOO_EDITION} (${PROJECT})
Requires=postgresql.service
After=network.target postgresql.service

[Service]
Type=simple
User=${ODOO_USER}
Group=${ODOO_USER}
ExecStart=${VENV}/bin/python ${ODOO_SRC}/odoo-bin -c ${CONF_FILE}
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=60
Restart=always
RestartSec=5
LimitNOFILE=65536
# hardening
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=${DATA_DIR} ${LOG_DIR}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=${SERVICE}

[Install]
WantedBy=multi-user.target
