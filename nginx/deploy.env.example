# Settings for nginx/autodeploy-nginx.sh. Copy, edit, then:
#   ./autodeploy-nginx.sh --config site.env --yes
# Anything left unset is prompted for, or takes its default with --yes.

PROJECT_NAME=mysite            # becomes the project directory (lowercase, a-z 0-9 -)
OVERWRITE=false                # true: replace an existing project directory
ODOO_EDITION=community         # community | enterprise
ODOO_VERSIONS=19               # comma-separated: 16, 17, 18, 19, 20
#ADMIN_PASSWD=                 # master password; empty = random (see odoo.conf)
BAKE_IMAGE=true                # true: bake requirements.txt into an image; false: pip at start
USE_NGINX=true                 # embedded nginx reverse proxy with host-based routing
NGINX_PORT=80
DOMAIN_MODE=sslip              # sslip | localhost | custom
#DOMAIN=odoo.example.com       # custom, single version
#DOMAIN_19=odoo19.example.com  # custom, per version
#BASE_PORT=8069                # without nginx: first host port (one per version)
PG_VERSION=18
USE_PGBOUNCER=true
TIMEZONE=Africa/Nairobi
